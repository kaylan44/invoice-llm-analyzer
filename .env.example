# Copy to .env (ignored by git) and fill in. Never commit real values.

# Gemini API key for local development, from its own Google project.
# Free tier: synthetic invoices only (see docs/architecture.md).
GEMINI_API_KEY=

# Set to "paid" only when GEMINI_API_KEY belongs to a Google project with billing enabled.
# The eval harness refuses to send real invoices (evals/data/real) without it.
# GEMINI_TIER=paid

# Model used for extraction: a configuration value, not a code constant.
EXTRACTION_MODEL=gemini-3.5-flash-lite

# Embedding model and size (the size is fixed by the migrations: vector(768)).
EMBEDDING_MODEL=gemini-embedding-2

# Local Postgres + pgvector from docker compose (not a secret). In production this is the
# Supabase connection string, set only in the deployed API's environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/invoices
